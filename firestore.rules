rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Catch-All Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Primitives
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.email in ["jcbprofesor@gmail.com", "managerproapp@gmail.com"]
      ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['admin', 'Administrador', 'Creador'])
        )) ||
        request.auth.token.email in ["jcbprofesor@gmail.com", "managerproapp@gmail.com"]
      ); 
    }
    function isManager() {
      return isAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['admin', 'almacen', 'Administrador', 'Almacén', 'Creador'])
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ===============================================================
    // Collection Validators
    // ===============================================================

    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() < 128 &&
             data.profiles is list && data.profiles.size() <= 10 &&
             data.activity_status in ['Activo', 'De Baja'] &&
             data.location_status in ['En el centro', 'Fuera del centro'];
    }

    function isValidProduct(data) {
      return data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 400 &&
             data.reference is string && data.reference.size() < 100 &&
             data.tax is number &&
             data.status in ['Activo', 'Inactivo'] &&
             data.category is string && data.family is string;
    }

    function isValidOrder(data) {
      return data.id is string &&
             data.user_id is string &&
             data.status is string && data.status.size() < 50 &&
             data.items is list && data.items.size() <= 100;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn(); // Basic reads for names/avatars 
      allow create: if isVerified() && isValidUser(incoming()) && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'avatar', 'location_status', 'teacherName', 'instituteName', 'teacherLogo', 'instituteLogo'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isManager() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isManager() && isValidProduct(incoming()) && 
                    incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /orders/{orderId} {
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isManager());
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isManager());
      allow create: if isSignedIn() && isValidOrder(incoming()) && (incoming().user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidOrder(incoming()) && (
        (existing().user_id == request.auth.uid && existing().status in ['Borrador', 'Enviado'] && 
         incoming().diff(existing()).affectedKeys().hasOnly(['items', 'notes', 'DiningServiceId', 'ダイニングサービスID', 'date'])) ||
        isManager()
      );
      allow delete: if isAdmin() || (existing().user_id == request.auth.uid && existing().status == 'Borrador');
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn() && (resource.data.is_public == true || resource.data.author_id == request.auth.uid || isManager());
      allow create: if isSignedIn() && (incoming().author_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (existing().author_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().author_id == request.auth.uid || isAdmin());
    }

    match /sale_items/{itemId} {
      allow read: if true;
      allow write: if isManager() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['teacher', 'sales_manager']));
    }

    match /reservations/{resId} {
      allow read: if isSignedIn();
      allow create: if true; 
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.user_id == request.auth.uid || isManager()));
    }

    match /mini_economato_stock/{id} {
        allow read: if isSignedIn();
        allow write: if isManager();
    }

    match /stock_receptions/{id} {
        allow read: if isSignedIn();
        allow write: if isManager();
    }

    match /messages/{messageId} {
      allow list: if isSignedIn() && (resource.data.sender_id == request.auth.uid || request.auth.uid in resource.data.recipient_ids || isAdmin());
      allow get: if isSignedIn() && (resource.data.sender_id == request.auth.uid || request.auth.uid in resource.data.recipient_ids || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.recipient_ids || isAdmin());
      allow delete: if isAdmin();
    }

    match /workspace_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /training_cycles/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /modules/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /groups/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /assignments/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /classrooms/{id} { allow read: if isSignedIn(); allow write: if isManager(); }
    match /classroom_orders/{id} { allow read, write: if isSignedIn(); }
    match /dining_services/{id} { allow read: if isSignedIn(); allow write: if isManager(); }
    match /dining_reservations/{id} { allow read, write: if isSignedIn(); }
    match /service_groups/{id} { allow read: if isSignedIn(); allow write: if isManager(); }
    match /services/{id} { allow read: if isSignedIn(); allow write: if isManager(); }
    
    match /company_info/{id} { allow read: if true; allow write: if isAdmin(); }
    match /creator_info/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sales/{id} { allow read: if isSignedIn(); allow write: if isManager() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['teacher', 'sales_manager'])); }
    match /classroom_products/{id} { allow read: if isSignedIn(); allow write: if isManager() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['teacher'])); }
    match /classroom_suppliers/{id} { allow read: if isSignedIn(); allow write: if isManager() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['teacher'])); }
    match /incidents/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
  }
}
