rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Primitives
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.email in ["jcbprofesor@gmail.com", "managerproapp@gmail.com"]
      ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['admin', 'creator', 'Administrador', 'Creador'])
        )) ||
        request.auth.token.email in ["jcbprofesor@gmail.com", "managerproapp@gmail.com"]
      ); 
    }
    function isManager() {
      return isAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profiles', []).hasAny(['admin', 'almacen', 'teacher', 'sales_manager', 'Administrador', 'Almacén', 'Profesor', 'Gestor de Ventas', 'Creador'])
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ===============================================================
    // Collection Validators
    // ===============================================================

    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() < 128 &&
             data.profiles is list && data.profiles.size() <= 10 &&
             data.activity_status in ['Activo', 'De Baja'] &&
             data.location_status in ['En el centro', 'Fuera del centro'];
    }

    function isValidProduct(data) {
      return data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 400 &&
             data.reference is string && data.reference.size() < 100 &&
             data.tax is number &&
             data.status in ['Activo', 'Inactivo'] &&
             data.category is string && data.family is string;
    }

    function isValidOrder(data) {
      return data.id is string &&
             data.user_id is string &&
             data.status is string && data.status.size() < 50 &&
             data.items is list && data.items.size() <= 100;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Academic Data (Broad Read for Signed-in Users)
    match /users/{id} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isOwner(id); }
    match /products/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /suppliers/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /events/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /incidents/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /training_cycles/{id} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /modules/{id} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /groups/{id} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /assignments/{id} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /recipes/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /sales/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /mini_economato_stock/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /classrooms/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /classroom_products/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /classroom_suppliers/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /classroom_events/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /service_groups/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /services/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /dining_services/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /stock_receptions/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }
    match /transfers/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }

    // Transactional Data
    match /orders/{id} {
      allow read, list: if isSignedIn() && (
        resource.data.user_id == request.auth.uid || 
        isManager()
      );
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().user_id == request.auth.uid;
      allow update: if isSignedIn() && isValidOrder(incoming()) && (
        isManager() || (
          existing().user_id == request.auth.uid && 
          incoming().user_id == existing().user_id &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'new_product_requests', 'cost', 'notes'])
        )
      );
      allow delete: if isManager();
    }
    match /classroom_orders/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /dining_reservations/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /reservations/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /messages/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /workspace_settings/{id} { allow read, list: if isSignedIn(); allow write: if isManager(); }

    // Settings (Public Read)
    match /settings/{doc=**} { allow read: if true; allow write: if isAdmin(); }
    match /settings { allow read: if true; }
    match /sale_items/{id} { allow read, list: if true; allow write: if isManager(); }

    // ===============================================================
    // Global Catch-All Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
