{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string" },
        "profiles": { "type": "array", "items": { "type": "string" } },
        "workspaceId": { "type": "string" },
        "teacherName": { "type": "string" },
        "teacherLogo": { "type": "string" },
        "instituteName": { "type": "string" },
        "instituteLogo": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "activity_status": { "type": "string", "enum": ["Activo", "De Baja"] },
        "location_status": { "type": "string", "enum": ["En el centro", "Fuera del centro"] },
        "contract_type": { "type": "string", "enum": ["Fijo", "Interino"] },
        "role_type": { "type": "string", "enum": ["Titular", "Sustituto"] },
        "classroom_id": { "type": "string" },
        "phone": { "type": "string" },
        "secondary_phone": { "type": "string" },
        "address": { "type": "string" },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "student_simulated_profile": { "type": "string", "enum": ["teacher", "almacen"] }
      },
      "required": ["id", "name", "email", "profiles", "activity_status", "location_status"]
    },
    "Product": {
      "title": "Product",
      "description": "Product information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "reference": { "type": "string" },
        "unit": { "type": "string" },
        "suppliers": { "type": "array", "items": { "$ref": "ProductSupplier" } },
        "tax": { "type": "number" },
        "category": { "type": "string" },
        "family": { "type": "string" },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Activo", "Inactivo"] },
        "product_state": { "type": "string" },
        "warehouse_status": { "type": "string" }
      },
      "required": ["id", "name", "reference", "unit", "tax", "category", "family", "status"]
    },
    "ProductSupplier": {
      "title": "ProductSupplier",
      "type": "object",
      "properties": {
        "supplier_id": { "type": "string" },
        "price": { "type": "number" }
      }
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cif": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "contact_person": { "type": "string" },
        "status": { "type": "string", "enum": ["Activo", "Inactivo"] },
        "website": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name", "cif", "status"]
    },
    "Event": {
      "title": "Event",
      "description": "Event information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Regular", "Extraordinario"] },
        "start_date": { "type": "string", "format": "date-time" },
        "end_date": { "type": "string", "format": "date-time" },
        "budget_per_teacher": { "type": "number" },
        "authorized_teachers": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Activo", "Inactivo"] }
      },
      "required": ["id", "name", "type", "start_date", "end_date", "budget_per_teacher", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Order information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "event_id": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "OrderItem" } },
        "new_product_requests": { "type": "array", "items": { "$ref": "NewProductRequest" } },
        "cost": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "user_id", "date", "status", "event_id", "items"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "tax": { "type": "number" }
      }
    },
    "NewProductRequest": {
      "title": "NewProductRequest",
      "type": "object",
      "properties": {
        "product_name": { "type": "string" },
        "quantity": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "Incident": {
      "title": "Incident",
      "description": "Incident report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "reported_by": { "type": "string" },
        "status": { "type": "string", "enum": ["Abierta", "En Progreso", "Resuelta"] },
        "supplier_id": { "type": "string" },
        "product_id": { "type": "string" },
        "event_id": { "type": "string" }
      },
      "required": ["id", "date", "description", "reported_by", "status", "supplier_id"]
    },
    "TrainingCycle": {
      "title": "TrainingCycle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Module": {
      "title": "Module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cycle_id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "cycle_id", "name"]
    },
    "Group": {
      "title": "Group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cycle_id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "cycle_id", "name"]
    },
    "Assignment": {
      "title": "Assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "group_id": { "type": "string" },
        "module_id": { "type": "string" }
      },
      "required": ["id", "user_id", "group_id", "module_id"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Recipe information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "author_id": { "type": "string" },
        "photo": { "type": "string" },
        "yield_amount": { "type": "number" },
        "yield_unit": { "type": "string" },
        "category": { "type": "string" },
        "ingredients": { "type": "array", "items": { "$ref": "RecipeIngredient" } },
        "preparation_steps": { "type": "string" },
        "key_points": { "type": "string" },
        "is_public": { "type": "boolean" },
        "cost": { "type": "number" },
        "price": { "type": "number" },
        "presentation": { "type": "string" },
        "temperature": { "type": "string", "enum": ["Caliente", "Frio", "Ambiente"] },
        "recommended_marking": { "type": "string" },
        "service_type": { "type": "string" },
        "client_description": { "type": "string" },
        "service_time": { "type": "string" },
        "selected_allergens": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "author_id", "yield_amount", "yield_unit", "category", "ingredients", "preparation_steps", "is_public", "cost", "price"]
    },
    "RecipeIngredient": {
      "title": "RecipeIngredient",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "cost": { "type": "number" }
      }
    },
    "StockItem": {
      "title": "StockItem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "stock": { "type": "number" },
        "min_stock": { "type": "number" },
        "is_shared": { "type": "boolean" }
      },
      "required": ["id", "stock", "min_stock"]
    },
    "Sale": {
      "title": "Sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacher_id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "teacher_id", "date", "amount", "category"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "recipient_ids": { "type": "array", "items": { "type": "string" } },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "read_by": { "type": "object" }
      },
      "required": ["id", "sender_id", "recipient_ids", "subject", "body", "date", "read_by"]
    },
    "Classroom": {
      "title": "Classroom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "tutor_id": { "type": "string" }
      },
      "required": ["id", "name", "code", "tutor_id"]
    },
    "ClassroomProduct": {
      "title": "ClassroomProduct",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "reference": { "type": "string" },
        "category": { "type": "string" },
        "classroom_id": { "type": "string" }
      },
      "required": ["id", "name", "reference", "category", "classroom_id"]
    },
    "ClassroomSupplier": {
      "title": "ClassroomSupplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "classroom_id": { "type": "string" }
      },
      "required": ["id", "name", "classroom_id"]
    },
    "ClassroomEvent": {
      "title": "ClassroomEvent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "start_date": { "type": "string", "format": "date-time" },
        "end_date": { "type": "string", "format": "date-time" },
        "classroom_id": { "type": "string" }
      },
      "required": ["id", "name", "start_date", "end_date", "classroom_id"]
    },
    "ClassroomOrder": {
      "title": "ClassroomOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "student_id": { "type": "string" },
        "event_id": { "type": "string" },
        "classroom_id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pendiente", "Completado"] },
        "items": { "type": "array", "items": { "$ref": "ClassroomOrderItem" } }
      },
      "required": ["id", "student_id", "event_id", "classroom_id", "date", "status", "items"]
    },
    "ClassroomOrderItem": {
      "title": "ClassroomOrderItem",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "quantity": { "type": "number" }
      }
    },
    "ServiceGroup": {
      "title": "ServiceGroup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacher_ids": { "type": "array", "items": { "type": "string" } },
        "roles": { "type": "object" }
      },
      "required": ["id", "name", "teacher_ids"]
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "service_group_id": { "type": "string" },
        "menu": { "type": "array", "items": { "$ref": "ServiceMenuItem" } },
        "roles": { "type": "object" },
        "status": { "type": "string", "enum": ["Planificación", "Confirmado", "Completado"] }
      },
      "required": ["id", "name", "date", "service_group_id", "menu", "roles", "status"]
    },
    "ServiceMenuItem": {
      "title": "ServiceMenuItem",
      "type": "object",
      "properties": {
        "recipe_id": { "type": "string" }
      }
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Settings specific to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "families": { "type": "array", "items": { "type": "string" } },
        "categoryConfigs": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["workspaceId", "categories"]
    },
    "SaleItem": {
      "title": "SaleItem",
      "description": "Information about a meal for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipe_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "rations": { "type": "number" },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "workspace_id": { "type": "string" },
        "status": { "type": "string", "enum": ["Activo", "Inactivo", "Preparacion"] },
        "created_at": { "type": "string", "format": "date-time" },
        "sale_date": { "type": "string", "format": "date-time" },
        "pickup_time": { "type": "string" },
        "end_time": { "type": "string" },
        "teacher_name": { "type": "string" },
        "group_name": { "type": "string" }
      },
      "required": ["id", "recipe_id", "name", "price", "rations", "workspace_id", "status", "created_at", "sale_date", "pickup_time", "end_time"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Reservation for a meal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sale_item_id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "quantity": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pendiente", "recogido", "cancelado"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sale_item_id", "user_name", "quantity", "status", "created_at"]
    },
    "DiningService": {
      "title": "DiningService",
      "description": "Dining hall service information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "max_capacity": { "type": "number" },
        "current_pax": { "type": "number" },
        "menu_price": { "type": "number" },
        "status": { "type": "string", "enum": ["borrador", "abierto", "cerrado"] },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "max_capacity", "current_pax", "menu_price", "status", "created_by", "created_at"]
    },
    "DiningReservation": {
      "title": "DiningReservation",
      "description": "Reservation for a dining hall service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service_id": { "type": "string" },
        "reference_name": { "type": "string" },
        "client_entity": { "type": "string" },
        "pax": { "type": "number" },
        "phone_1": { "type": "string" },
        "phone_2": { "type": "string" },
        "total_price": { "type": "number" },
        "table_number": { "type": "string" },
        "diners_allergens": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "diner_name": { "type": "string" },
              "allergens": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "service_id", "reference_name", "pax", "total_price", "created_by", "created_at"]
    },
    "StockReception": {
      "title": "StockReception",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "supplier_id": { "type": "string" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "supplier_id", "products"]
    },
    "SupplierReception": {
      "title": "SupplierReception",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplier_id": { "type": "string" },
        "event_id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": { "type": "string" },
              "ordered_quantity": { "type": "number" },
              "received_quantity": { "type": "number" },
              "price": { "type": "number" },
              "is_correct": { "type": "boolean" },
              "weight_diff": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "general_notes": { "type": "string" }
      },
      "required": ["id", "supplier_id", "event_id", "date", "items"]
    },
    "Transfer": {
      "title": "Transfer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "from_user_id": { "type": "string" },
        "from_assignment_id": { "type": "string" },
        "to_event_id": { "type": "string" },
        "amount": { "type": "number" },
        "concept": { "type": "string" },
        "units": { "type": "number" },
        "price_per_unit": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Completado", "Pendiente"] }
      },
      "required": ["id", "from_user_id", "to_event_id", "amount", "concept", "date", "status"]
    },
    "AcademicYear": {
      "title": "AcademicYear",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "start_date": { "type": "string", "format": "date-time" },
        "end_date": { "type": "string", "format": "date-time" },
        "is_active": { "type": "boolean" }
      },
      "required": ["id", "name", "start_date", "end_date", "is_active"]
    }
  },
  "firestore": {
    "/users": { "schema": "User", "description": "Collection of users" },
    "/products": { "schema": "Product", "description": "Collection of products" },
    "/suppliers": { "schema": "Supplier", "description": "Collection of suppliers" },
    "/events": { "schema": "Event", "description": "Collection of events" },
    "/orders": { "schema": "Order", "description": "Collection of orders" },
    "/recipes": { "schema": "Recipe", "description": "Collection of recipes" },
    "/incidents": { "schema": "Incident", "description": "Collection of incidents" },
    "/sales": { "schema": "Sale", "description": "Collection of sales" },
    "/messages": { "schema": "Message", "description": "Collection of messages" },
    "/classrooms": { "schema": "Classroom", "description": "Collection of classrooms" },
    "/classroom_products": { "schema": "ClassroomProduct", "description": "Collection of classroom products" },
    "/classroom_suppliers": { "schema": "ClassroomSupplier", "description": "Collection of classroom suppliers" },
    "/classroom_events": { "schema": "ClassroomEvent", "description": "Collection of classroom events" },
    "/classroom_orders": { "schema": "ClassroomOrder", "description": "Collection of classroom orders" },
    "/service_groups": { "schema": "ServiceGroup", "description": "Collection of service groups" },
    "/services": { "schema": "Service", "description": "Collection of services" },
    "/training_cycles": { "schema": "TrainingCycle", "description": "Collection of training cycles" },
    "/modules": { "schema": "Module", "description": "Collection of modules" },
    "/groups": { "schema": "Group", "description": "Collection of groups" },
    "/assignments": { "schema": "Assignment", "description": "Collection of assignments" },
    "/mini_economato_stock": { "schema": "StockItem", "description": "Collection of mini economato stock" },
    "/workspace_settings/{workspaceId}": { "schema": "WorkspaceSettings", "description": "Settings specific to a workspace" },
    "/sale_items": { "schema": "SaleItem", "description": "Collection of sale items" },
    "/reservations": { "schema": "Reservation", "description": "Collection of reservations" },
    "/dining_services": { "schema": "DiningService", "description": "Collection of dining services" },
    "/dining_reservations": { "schema": "DiningReservation", "description": "Collection of dining reservations" },
    "/stock_receptions": { "schema": "StockReception", "description": "Collection of stock receptions" },
    "/supplier_receptions": { "schema": "SupplierReception", "description": "Collection of supplier receptions" },
    "/transfers": { "schema": "Transfer", "description": "Collection of transfers" },
    "/academic_years": { "schema": "AcademicYear", "description": "Collection of academic years" }
  }
}
